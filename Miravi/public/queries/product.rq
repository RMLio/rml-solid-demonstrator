PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ex: <http://example.com/>
PREFIX voc: <http://example.com/voc/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?product 
       (ROUND(?volumeRaw) AS ?volumeML)
       ((ROUND(?benzeneRaw * 100) / 100) AS ?benzenePCT)
       ((ROUND(?recycledRaw * 100) / 100) AS ?recycledPCT)
       ?country ?manufacturer
WHERE {
    ?ProductID a voc:Product ;
        voc:category $Category ;
        rdfs:label ?product ;
        voc:volumeML ?volumeRaw ;
        voc:percentageBenzene ?benzeneRaw ;
        voc:percentageRecycled ?recycledRaw ;
        voc:originCountry ?country ;
        voc:manufacturer ?manufacturerID.
    ?manufacturerID rdfs:label ?manufacturer. 
}
ORDER BY ?product

